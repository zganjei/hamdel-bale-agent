TELEGRAM_BOT_TOKEN=            # token of the NEW bot from Bale's bot father
LLM_PROVIDER=claudecode    # Claude Code CLI logged in with your Claude subscription (no API key)
CLAUDE_CODE_OAUTH_TOKEN=   # output of `claude setup-token`, or leave empty if you ran `claude` and logged in on the server
CLAUDE_CODE_MODEL=sonnet
GEMINI_API_KEY=            # free key from aistudio.google.com; used for speech-to-text when set (better for Persian)
GEMINI_MODEL=gemini-2.5-flash
CLOUDFLARE_ACCOUNT_ID=     # optional fallback speech-to-text (free Workers AI)
CLOUDFLARE_API_TOKEN=
OWNER_ID=                  # your Telegram user id (send /whoami to the bot in private)
GROUP_CHAT_ID=             # the group id (send /whoami inside the group)
REPORT_SENDER=             # optional: only this @username counts in the group (empty = anyone in the group)
QUIET_SECONDS=120
DATA_DIR=/opt/hamdel/data
